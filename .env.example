# Inkling-2-Mini EXLR8 + Melded DFlash2 on 1x DGX Spark (NVIDIA GB10)
# Copy to .env and adjust as needed:  cp .env.example .env

# Published gr8 container image (includes g6m4_ink2 TP=1, g6front-rs, g6s2shim.py from PR #615+)
GR8_IMAGE=ghcr.io/kindlingai/gr8:main

# Host directory containing the downloaded kindlingai/inkling-2-mini-exlr8-k2-k3-k4 pack
# (with dflash2-melded.safetensors inside — auto-discovered with zero extra flags)
MODEL_DIR=./models/inkling-2-mini-exlr8-k2-k3-k4

# Width manifest preset:
#   k4     — KL Champion (18.72 GB dev img, -27.4% KL vs Official NVFP4, tied on 1,362 real-world tasks)
#   bit325 — Balanced Daily Driver (16.43 GB, 8/8 exact greedy parity, 3,484 tok/s 8K prefill)
#   bit250 — Compact High-Speed (14.13 GB, 111 tok/s Code, 133 tok/s Math)
#   k2     — Speed Sweep Champion (12.60 GB, -11.65% E2E KL, 11/11 sweep vs vLLM & TensorFold)
VARIANT=k4

# Speculative decoding (auto-discovers dflash2-melded.safetensors in MODEL_DIR)
MTP=7

# Context & serving geometry (increase CAP=139264 for 128K single-stream context)
CAP=16384
SESSIONS=8
CHUNK=8
PREFILL=4096
PORT=8100

# Unified high-quality ship defaults (0.000000 decode KL delta vs pure tr3):
#   PF_MX8_MOE=2  — cached MXFP8 prefill MoE (3,457-3,484 tok/s 8K cold prefill)
#   MX8_DENSE=2   — MXFP8 dense projections for prefill (M>=64), BF16 for decode
#   MX8_LM_HEAD=0 — BF16 lm_head
GR8_INK2_DF2_Q8=0
GR8_INK2_PF_MX8_MOE=2
GR8_INK2_MX8_DENSE=2
GR8_INK2_MX8_LM_HEAD=0

# Optional: uncomment for maximum speed sweep on VARIANT=k2
# GR8_INK2_MX8_DENSE=1
# GR8_INK2_MX8_LM_HEAD=1
# GR8_S2_ADAPT=1
# GR8_INK2_S2_COST=14.0,2.5,2.0,0.4,0.0,0.0
